# Copy this file to .env and replace every placeholder.
# .env is git-ignored — never commit real credentials.
#
# Generate strong local secrets, e.g. in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})

# --- PostgreSQL (compose dev database) ---
POSTGRES_USER=webtest
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=webtest
# Loopback port published by compose.yaml (127.0.0.1 only).
DB_PORT=5432

# --- API (consumed by cmd/api and cmd/migrate) ---
DB_HOST=127.0.0.1
DB_NAME=webtest
DB_USER=webtest
DB_PASSWORD=                  # must match POSTGRES_PASSWORD for the local container
DB_SSLMODE=disable            # disable locally; require/verify-full in production
DB_AUTO_MIGRATE=true          # dev only; production runs cmd/migrate as its own step
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_REQUEST_BODY_BYTES=10485760  # 10 MiB, must cover screenshot uploads
APP_ENV=development           # development | test | production
LOG_LEVEL=debug               # debug | info | warn | error
LOG_FORMAT=text               # text locally, json in containers
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=                   # required, min 32 characters
JWT_TTL=24h

# --- Worker (consumed from Phase 4 onward) ---
# WORKER_URL=http://127.0.0.1:8090
# WORKER_SHARED_SECRET=       # required, shared with the worker process

# --- Worker (consumed from Phase 4 onward) ---
# WORKER_URL=http://127.0.0.1:8090
# WORKER_SHARED_SECRET=  # required, shared with the worker process
